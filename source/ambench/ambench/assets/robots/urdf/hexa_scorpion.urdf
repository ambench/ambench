<?xml version="1.0"?>
<robot name="hexa_scorpion_robot">

    <link name="base_link">
        <!-- INERTIAL PROPERTIES (Approximation based on summed mass and dimensions) -->
        <inertial>
            <!-- Total Mass: 5.0 (base) + 6*0.1 (arms) + 6*0.0025 (thrusters) = 5.615 kg -->
            <mass value="5.615"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.198" ixy="0.0" ixz="0.0"
                    iyy="0.198" iyz="0.0" izz="0.460"/>
        </inertial>

        <visual>
            <!-- Drone Base -->
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/hexa_scorpion/v2_drone_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <!-- <material name="CheckeredMaterial">
                <color rgba="0.5 0.5 0.5 1"/>
            </material> -->
        </visual>

        <!-- Propeller Arms (6 Meshes) -->
        <visual>
            <origin xyz="0.0 0.026 -0.011" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/hexa_scorpion/v2_prop_arm_cw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <visual>
            <origin xyz="-0.0231 0.013 -0.011" rpy="0 0 1.047"/>
            <geometry>
                <mesh filename="meshes/hexa_scorpion/v2_prop_arm_ccw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <visual>
            <origin xyz="-0.0231 -0.013 -0.011" rpy="0 0 2.094"/>
            <geometry>
                <mesh filename="meshes/hexa_scorpion/v2_prop_arm_cw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <visual>
            <origin xyz="0.0 -0.026 -0.011" rpy="0 0 3.1415"/>
            <geometry>
                <mesh filename="meshes/hexa_scorpion/v2_prop_arm_ccw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <visual>
            <origin xyz="0.0231 -0.013 -0.011" rpy="0 0 -2.094"/>
            <geometry>
                <mesh filename="meshes/hexa_scorpion/v2_prop_arm_cw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <visual>
            <origin xyz="0.0231 0.013 -0.011" rpy="0 0 -1.047"/>
            <geometry>
                <mesh filename="meshes/hexa_scorpion/v2_prop_arm_ccw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <!-- COLLISION GEOMETRIES (For physics and contact) - ORIENTATIONS CORRECTED -->
        <!-- Base collision: Using cylinder primitive for accurate capsule representation -->
        <!-- Cylinder creates a capsule with exact radius and height (no approximation needed) -->
        <!-- Adjust radius and length to match your actual base dimensions -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <!-- For a 1.0m x 1.0m square base, use radius=0.5m (half the width) -->
                <!-- For a circular base, use the actual radius -->
                <!-- Note: Height should be large enough to create visible capsule (not sphere) -->
                <!-- If base is very thin, consider using a slightly larger height for visualization -->
                <cylinder radius="0.6" length="0.05"/>
            </geometry>
        </collision>

        <!-- Propeller Arms (6 Meshes) - Collision disabled to prevent oversized base capsule -->
        <!-- If propeller arm collision is needed, consider moving them to separate links -->
        <!--
        <collision>
            <origin xyz="0.0 0.026 -0.011" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/hexa_scorpion/v2_prop_arm_cw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="-0.0231 0.013 -0.011" rpy="0 0 1.047"/>
            <geometry>
                <mesh filename="meshes/hexa_scorpion/v2_prop_arm_ccw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
