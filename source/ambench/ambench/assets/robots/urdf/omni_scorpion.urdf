<?xml version="1.0"?>
<robot name="omni_scorpion">

    <!-- Materials -->
    <material name="black_glossy">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <material name="red">
        <color rgba="0.6 0.1 0.1 1.0"/>
    </material>

    <material name="white">
        <color rgba="0.95 0.95 0.95 1.0"/>
    </material>

    <!-- Root / drone body: body-fixed frame aligned with global (x_body = x_global) -->
    <link name="base_link">
        <inertial>
            <!-- Approximation: main body without separate arm/prop links -->
            <mass value="2.3"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0"
                    iyy="0.1" iyz="0.0" izz="0.2"/>
        </inertial>
        <visual>
            <!-- Mesh orientation: -pi/2 yaw from prior body frame -->
            <origin xyz="0 0 0" rpy="0 0 -1.5707963267948966"/>
            <geometry>
                <mesh filename="meshes/oam_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
             <material name="black_glossy"/>
        </visual>
    </link>

    <!-- Motor Arms -->
    <link name="motor_arm_1">
        <inertial>
            <mass value="0.08"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/motor_arm_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
             <material name="black_glossy"/>
        </visual>
    </link>

    <link name="prop_1">
        <inertial>
            <mass value="0.0025"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/sixinch_3blade_prop.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <link name="motor_arm_2">
        <inertial>
            <mass value="0.08"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/motor_arm_2.stl" scale="0.001 0.001 0.001"/>
            </geometry>
             <material name="black_glossy"/>
        </visual>
    </link>

    <link name="prop_2">
        <inertial>
            <mass value="0.0025"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/sixinch_3blade_prop.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <link name="motor_arm_3">
        <inertial>
            <mass value="0.08"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/motor_arm_3.stl" scale="0.001 0.001 0.001"/>
            </geometry>
             <material name="black_glossy"/>
        </visual>
    </link>

    <link name="prop_3">
        <inertial>
            <mass value="0.0025"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/sixinch_3blade_prop.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <link name="motor_arm_4">
        <inertial>
            <mass value="0.08"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/motor_arm_4.stl" scale="0.001 0.001 0.001"/>
            </geometry>
             <material name="black_glossy"/>
        </visual>
    </link>

    <link name="prop_4">
        <inertial>
            <mass value="0.0025"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/sixinch_3blade_prop.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <link name="motor_arm_5">
        <inertial>
            <mass value="0.08"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/motor_arm_5.stl" scale="0.001 0.001 0.001"/>
            </geometry>
             <material name="black_glossy"/>
        </visual>
    </link>

    <link name="prop_5">
        <inertial>
            <mass value="0.0025"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/sixinch_3blade_prop.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <link name="motor_arm_6">
        <inertial>
            <mass value="0.08"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/motor_arm_6.stl" scale="0.001 0.001 0.001"/>
            </geometry>
             <material name="black_glossy"/>
        </visual>
    </link>

    <link name="prop_6">
        <inertial>
            <mass value="0.0025"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/sixinch_3blade_prop.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <!-- Manipulator arm -->
    <link name="link1">
        <inertial>
            <mass value="0.2"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0005" iyy="0.0001" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/link1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black_glossy"/>
        </visual>
    </link>

    <link name="link2">
        <inertial>
            <mass value="0.2"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0005" iyy="0.0001" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/link2.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black_glossy"/>
        </visual>
    </link>

    <link name="end_effector">
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/end_effector.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <link name="gripper">
        <inertial>
            <mass value="0.05"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/gripper.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <!-- Joints -->
    <joint name="base_motor_arm1" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 -1.5707963267948966"/>
        <parent link="base_link"/>
        <child link="motor_arm_1"/>
        <axis xyz="0.5 -0.8660254037844386 0.0"/>
        <limit lower="-6.283185307179586" upper="6.283185307179586" effort="20" velocity="5"/>
    </joint>

    <joint name="motor_arm1_prop" type="fixed">
        <origin xyz="0.089682 -0.153329 0.03" rpy="0 0 0"/>
        <parent link="motor_arm_1"/>
        <child link="prop_1"/>
    </joint>

    <joint name="base_motor_arm2" type="revolute">
        <origin xyz="0 0.003 0" rpy="0 0 -1.5707963267948966"/>
        <parent link="base_link"/>
        <child link="motor_arm_2"/>
        <axis xyz="1.0 0.0 0.0"/>
        <limit lower="-6.283185307179586" upper="6.283185307179586" effort="20" velocity="5"/>
    </joint>

    <joint name="motor_arm2_prop" type="fixed">
        <origin xyz="0.181138 0 0.03" rpy="0 0 0"/>
        <parent link="motor_arm_2"/>
        <child link="prop_2"/>
    </joint>

    <joint name="base_motor_arm3" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 -1.5707963267948966"/>
        <parent link="base_link"/>
        <child link="motor_arm_3"/>
        <axis xyz="0.5 0.8660254037844386 0.0"/>
        <limit lower="-6.283185307179586" upper="6.283185307179586" effort="20" velocity="5"/>
    </joint>

    <joint name="motor_arm3_prop" type="fixed">
        <origin xyz="0.090192 0.156211 0.03" rpy="0 0 0"/>
        <parent link="motor_arm_3"/>
        <child link="prop_3"/>
    </joint>

    <joint name="base_motor_arm4" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 -1.5707963267948966"/>
        <parent link="base_link"/>
        <child link="motor_arm_4"/>
        <axis xyz="-0.5 0.8660254037844386 0.0"/>
        <limit lower="-6.283185307179586" upper="6.283185307179586" effort="20" velocity="5"/>
    </joint>

    <joint name="motor_arm4_prop" type="fixed">
        <origin xyz="-0.089399 0.154892 0.03" rpy="0 0 0"/>
        <parent link="motor_arm_4"/>
        <child link="prop_4"/>
    </joint>

    <joint name="base_motor_arm5" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 -1.5707963267948966"/>
        <parent link="base_link"/>
        <child link="motor_arm_5"/>
        <axis xyz="-1 0.0 0.0"/>
        <limit lower="-6.283185307179586" upper="6.283185307179586" effort="20" velocity="5"/>
    </joint>

    <joint name="motor_arm5_prop" type="fixed">
        <origin xyz="-0.178796 0.0 0.03" rpy="0 0 0"/>
        <parent link="motor_arm_5"/>
        <child link="prop_5"/>
    </joint>

    <joint name="base_motor_arm6" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 -1.5707963267948966"/>
        <parent link="base_link"/>
        <child link="motor_arm_6"/>
        <axis xyz="-0.5 -0.8660254037844386 0.0"/>
        <limit lower="-6.283185307179586" upper="6.283185307179586" effort="20" velocity="5"/>
    </joint>

    <joint name="motor_arm6_prop" type="fixed">
        <origin xyz="-0.087683 -0.150797 0.03" rpy="0 0 0"/>
        <parent link="motor_arm_6"/>
        <child link="prop_6"/>
    </joint>

    <joint name="servo1" type="revolute">
        <!-- Deployment offset: 45 deg about Y at q=0 -->
        <origin xyz="0 0 0.085" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="link1"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="-3.14159265358979" upper="3.14159265358979" effort="20" velocity="5"/>
    </joint>

    <joint name="servo2" type="revolute">
        <!-- Deployment offset: 45 deg about Y at q=0 -->
        <origin xyz="0.0 0.0 0.172" rpy="0 0 0"/>
        <parent link="link1"/>
        <child link="link2"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="-3.14159265358979" upper="3.14159265358979" effort="20" velocity="5"/>
    </joint>

    <joint name="servo3" type="revolute">
        <origin xyz="0.0 0.0 0.1575" rpy="0 0 0"/>
        <parent link="link2"/>
        <child link="end_effector"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="-3.14159265358979" upper="3.14159265358979" effort="20" velocity="5"/>
    </joint>

    <joint name="servo4" type="revolute">
        <origin xyz="0.0 0.0 0.0445" rpy="0 0 0"/>
        <parent link="end_effector"/>
        <child link="gripper"/>
        <axis xyz="1.0 0.0 0.0"/>
        <limit lower="-3.14159265358979" upper="3.14159265358979" effort="20" velocity="5"/>
    </joint>

</robot>
